#!/usr/bin/env sh
set -euo pipefail

# Set PATH before anything else: launchd starts this service with a minimal
# PATH that omits /opt/homebrew/bin and /usr/local/bin, so tools like
# `aerospace` (used by display_mode.sh) would not be found. Combined with
# `set -e` above, a not-found command would abort the rc and leave an empty bar.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

~/.config/display_mode.sh # upon restart, display bar based on mirror or laptop mode

export CONFIG_DIR="$HOME/.config/sketchybar"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"

# Start stats_provider for CPU temperature
killall stats_provider 2>/dev/null || true
# stats_provider --memory ram_available &

# Detect mirroring to an external monitor (this laptop is never in clamshell).
# When mirrored, the external monitor has no notch, so keep the bar on top.
DISPLAYS=$(system_profiler SPDisplaysDataType 2>/dev/null)
case "$DISPLAYS" in
  *"Mirror: On"*) MIRRORING=Yes ;;
  *) MIRRORING=No ;;
esac
if [ "$MIRRORING" = "Yes" ]; then
  TOPMOST=on
else
  TOPMOST=off
fi

# Bar
sketchybar --bar position=top height=32 color="$BAR_COLOR" display=all
# sketchybar --bar position=top height=32 color="$BAR_COLOR" display=all topmost=off

# Defaults
default=(
  padding_left=6
  padding_right=6
  icon.font="Hack Nerd Font:Regular:12.0"
  label.font="Hack Nerd Font:Regular:12.0"
  icon.color="$WHITE"
  label.color="$WHITE"
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=6
  label.padding_right=6
  background.drawing=off
  background.height=18
  background.corner_radius=5
  background.color=$ITEM_BG_COLOR
  updates=on
)
sketchybar --default "${default[@]}"


# # --- Front app left side (so it won't sit under the notch) ---
sketchybar --add item front_app_left left \
  --set front_app_left \
    script="$PLUGIN_DIR/front_app.sh" \
    icon.drawing=off \
    label.padding_left=10 \
    label.padding_right=10 \
    background.drawing=on \
    background.color=0x22ffffff \
    background.corner_radius=6 \
    background.height=18 \
  --subscribe front_app_left front_app_switched

# run once at startup so it shows immediately
sketchybar --trigger front_app_switched

# memory usage graph (left, right after the app chip)
sketchybar --add graph mem_graph left 50
sketchybar --set mem_graph \
  script="$PLUGIN_DIR/memory_graph.sh" \
  update_freq=5 \
  icon.drawing=off \
  label.drawing=on \
  label.color=0xffa6e3a1 \
  graph.color=0xffa6e3a1 \
  graph.fill_color=0x55a6e3a1 \
  graph.line_width=2 \
  drawing=on

# my pending diffs -> one chip per diff (e.g. "D994: Passed"), managed by the
# diff_status driver item, which is itself invisible.
sketchybar --add item diff_status left \
  --set diff_status \
    update_freq=300 \
    drawing=off \
    script="$PLUGIN_DIR/diff_status.sh" \
  --subscribe diff_status system_woke

# sleep toggle (pmset -a disablesleep) — click to keep the Mac awake
sketchybar --add item sleep_toggle left \
  --set sleep_toggle \
    update_freq=30 \
    icon.font="Hack Nerd Font:Regular:14.0" \
    label.padding_right=8 \
    background.corner_radius=6 \
    background.height=18 \
    script="$PLUGIN_DIR/sleep_toggle.sh" \
  --subscribe sleep_toggle mouse.clicked

# next meeting + minutes left (blue, red under 15 min) — after the awake chip
sketchybar --add item next_meeting left \
  --set next_meeting \
    update_freq=60 \
    icon.drawing=off \
    label.padding_left=8 \
    label.padding_right=8 \
    script="$PLUGIN_DIR/next_meeting.sh" \
    click_script="open 'https://calendar.google.com/calendar/u/0/r'" \
  --subscribe next_meeting system_woke

# pomodoro timer
sketchybar --add event timer_change
sketchybar --add item timer left \
  --set timer \
    script="$PLUGIN_DIR/timer.sh" \
    update_freq=0 \
    icon.color=0xffcba6f7 \
    label.color=0xffcba6f7 \
    icon.font="Hack Nerd Font:Regular:14.0" \
    drawing=off \
  --subscribe timer timer_change

# --- Right side items (NO battery) ---
# sketchybar --add item volume right \
#   --set volume script="$PLUGIN_DIR/volume.sh" \
#   --subscribe volume volume_change

# sketchybar --add item clock right \
#   --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh"

# clock
sketchybar --add item clock right
sketchybar --set clock \
  update_freq=10 \
  script="$PLUGIN_DIR/clock.sh"

# CPU graph
sketchybar --add graph cpu_usage right 50
sketchybar --set cpu_usage \
  script="$PLUGIN_DIR/cpu_usage.sh" \
  update_freq=10 \
  icon.drawing=off \
  label.drawing=on \
  graph.color=0xffcba6f7 \
  graph.fill_color=0x55cba6f7 \
  graph.line_width=2 \
  drawing=on

# CPU temperature (via macmon)
sketchybar --add item cpu_temp right
sketchybar --set cpu_temp \
  update_freq=15 \
  icon.drawing=off \
  label.color=0xfff38ba8 \
  label="--" \
  script="$PLUGIN_DIR/cpu_temp.sh"

# power draw (watts, via macmon)
sketchybar --add item power_draw right
sketchybar --set power_draw \
  update_freq=15 \
  icon.drawing=off \
  label.color=0xfffab387 \
  label="--" \
  script="$PLUGIN_DIR/power_draw.sh"

# memory usage (used GB + % of RAM)
sketchybar --add item memory right
sketchybar --set memory \
  update_freq=10 \
  icon.drawing=off \
  label.color=0xffa6e3a1 \
  script="$PLUGIN_DIR/memory_usage.sh"

# ram available
# sketchybar --add item ram_available right \
#   --set ram_available \
#     icon="Free" \
#     icon.drawing=on \
#     script="sketchybar --set ram_available label=\"\$RAM_AVAILABLE\"" \
#   --subscribe ram_available system_stats

# swap used
# sketchybar --add item swp_used right \
#   --set swp_used \
#     icon="Swp" \
#     icon.drawing=on \
#     script="sketchybar --set swp_used label=\"\$SWP_USED\"" \
#   --subscribe swp_used system_stats


# volume
sketchybar --add item volume right \
    --set volume \
      script="$PLUGIN_DIR/volume.sh" \
      padding_right=4 \
    --subscribe volume volume_change \

# battery
sketchybar --add item battery right
sketchybar --set battery \
    update_freq=600 \
    script="$PLUGIN_DIR/battery.sh" \
    icon.font="Hack Nerd Font:Regular:16.0" \
    padding_right=4 \
  --subscribe battery system_woke power_source_change 
  

# gpu fps (removed — helper wasn't producing data, item just showed "--")
# sketchybar --add item gpu_fps right
# sketchybar --set gpu_fps \
#   icon.drawing=off \
#   label="--" \
#   label.color=0xffa6e3a1 \
#   label.padding_left=5



# weather
# sketchybar --add item weather right \
#   --set weather \
#     script="$PLUGIN_DIR/weather.sh" \
#     update_freq=1800 \
#     icon.drawing=off \
#     label.color=$WHITE \
#     click_script="open -a Weather"


# --- Aerospace (current workspace, event-driven) ---
if command -v aerospace >/dev/null 2>&1 \
  || [ -x /opt/homebrew/bin/aerospace ] \
  || [ -x /usr/local/bin/aerospace ] \
  || [ -x "$HOME/.local/bin/aerospace" ]; then
  sketchybar --add event aerospace_workspace_change

  sketchybar --add item aero_space right \
    --set aero_space \
      script="$PLUGIN_DIR/aerospace_current.sh" \
      icon.drawing=off \
      padding_left=0 \
      background.drawing=on \
      background.color=0x33ffffff \
      background.corner_radius=6 \
      background.height=18 \
      label.padding_left=10 \
      label.padding_right=10 \
      label.font="Hack Nerd Font:Bold:12.0" \
    --subscribe aero_space aerospace_workspace_change

  # run once at startup
  sketchybar --trigger aerospace_workspace_change
fi

# top CPU process
sketchybar --add item top_process right \
  --set top_process \
    icon.drawing=off \
    label.color=0xffcba6f7 \
    script="$PLUGIN_DIR/top_process.sh" \
    update_freq=10



# fps helper daemon disabled (gpu_fps item removed)
killall fps_helper 2>/dev/null || true
# if [ -x "$CONFIG_DIR/bin/fps_helper" ]; then
#   "$CONFIG_DIR/bin/fps_helper" >/dev/null 2>&1 &
#   disown
# fi

# force all scripts to run once
sketchybar --update

