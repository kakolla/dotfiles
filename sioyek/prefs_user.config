dark_mode_background_color 0.02 0.02 0.11
dark_mode_contrast 0.85


page_separator_width 2
page_separator_color 0.3 0.28 0.4

# run on startup so two-page view is on by default on every machine
startup_commands toggle_two_page_mode

# zoom is multiplicative per step (default 1.2 = 20% per press); 1.05 = ~5% per press
zoom_inc_factor 1.05
